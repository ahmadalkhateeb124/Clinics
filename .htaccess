# ── Nour's Touch Clinic — Public Site ─────────────────────────────────────
Options -Indexes -MultiViews
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /nourstouch/

    # Block dotfiles
    RewriteRule (^|/)\. - [F]

    # Don't rewrite real files/dirs
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # sitemap.xml served by index.php
    RewriteRule ^sitemap\.xml$ index.php?url=sitemap.xml [L]

    # Friendly URLs → index.php?url=...
    RewriteRule ^([^/]+)/?$ index.php?url=$1 [QSA,L]
    RewriteRule ^([^/]+)/([^/]+)/?$ index.php?url=$1&puid=$2 [QSA,L]
</IfModule>

# ── Security headers ─────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # Stop MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Leak less in Referer
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Disable unneeded browser features
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=()"

    # Cross-origin policies (safe defaults)
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-site"

    # HSTS — only meaningful over HTTPS; harmless on HTTP. Enable on production.
    Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains" "expr=%{HTTPS} == 'on'"

    # Content-Security-Policy
    # NOTE: 'unsafe-inline' is needed for now because the codebase has inline
    # <script>/<style> blocks and inline event handlers. Tighten later by
    # moving inline JS/CSS to external files and switching to nonces.
    Header always set Content-Security-Policy "default-src 'self'; \
        base-uri 'self'; \
        object-src 'none'; \
        frame-ancestors 'self'; \
        form-action 'self'; \
        img-src 'self' data: blob: https:; \
        font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; \
        style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; \
        script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; \
        connect-src 'self'; \
        frame-src 'self' https://www.google.com https://maps.google.com; \
        upgrade-insecure-requests"

    # Strip server fingerprint
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# Block sensitive files
<FilesMatch "\.(env|sql|log|md|json|lock|ini|sh)$">
    Require all denied
</FilesMatch>

<Files "*credentials*">
    Require all denied
</Files>
