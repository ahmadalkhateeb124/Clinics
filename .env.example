# ════════════════════════════════════════════════════════════════════════
# Nour's Touch Clinic — Environment template
#
# This file is a reference. The app does NOT load .env directly — instead,
# copy values into:
#
#   inc/db.credentials.php
#   BusinessPortal/config/database.credentials.php
#   …or use the admin panel at /BusinessPortal/admin/settings.php
# ════════════════════════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────────────────────
APP_NAME="Nour's Touch Clinic"
APP_NAME_AR="عيادة لمسة نور"
APP_URL=https://nourstouch.com/
APP_LOCALE=ar
APP_TIMEZONE=Asia/Amman
APP_CURRENCY=JOD

# ── Database (copy to BusinessPortal/config/database.credentials.php) ──
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nourstouch
DB_USER=root
DB_PASS=

# ── Mail (configure in admin Settings → Mail group) ─────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=tls           # tls | ssl | (empty for none)
MAIL_USER=no-reply@nourstouch.com
MAIL_PASS=
MAIL_FROM=no-reply@nourstouch.com
MAIL_FROM_NAME="Nour's Touch Clinic"

# ── Default admin (created by installer; change on first login) ─────────
ADMIN_EMAIL=admin@clinic.com
ADMIN_PASSWORD=Admin@123

# ── Working hours (configurable from Settings → general) ────────────────
WORKING_HOURS_FROM=09:00
WORKING_HOURS_TO=21:00

# ── Cron paths (no env variables — use crontab; see README) ─────────────
# */15 * * * * /usr/bin/php /full/path/BusinessPortal/cron/send-reminders.php
# 0    3 * * * /usr/bin/php /full/path/BusinessPortal/cron/backup-db.php
