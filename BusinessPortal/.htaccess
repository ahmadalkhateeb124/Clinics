Options -Indexes -MultiViews
ServerSignature Off

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<FilesMatch "\.(env|sql|log|ini|sh|md|json|lock)$">
    Require all denied
</FilesMatch>

<Files "*credentials*">
    Require all denied
</Files>

# Block direct access to config/includes via per-folder .htaccess files
